{
  "name": "specref-bibtex",
  "version": "1.0.0",
  "private": true,
  "description": "The Specref reference database as a single BibTeX file, refreshed daily",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env src/build.ts && tsc -p site",
    "test": "node --test",
    "typecheck": "tsc -p . && tsc -p site --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
